# Anthropic API — powers the villain AIs (model: claude-haiku-4-5)
# Get a key at https://console.anthropic.com  — NEVER commit the real .env
ANTHROPIC_API_KEY=

# Vercel KV (Redis) — daily free-run cap + leaderboard. Filled by Vercel on link.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# iron-session — encrypts the run-state cookie (secret + defenses + turn count).
# Must be at least 32 characters. Generate: openssl rand -base64 32
SESSION_PASSWORD=
